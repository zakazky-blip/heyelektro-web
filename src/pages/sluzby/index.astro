---
import { link } from "../../lib/url";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import ServiceCards from "../../components/ServiceCards.astro";
import FormSection from "../../components/FormSection.astro";
import PhoneCta from "../../components/PhoneCta.astro";
import Icon from "../../components/Icon.astro";
import { serviceGroups, servicesIn } from "../../data/services";
import { photos } from "../../data/images";
import { breadcrumbSchema } from "../../lib/schema";
import { cz } from "../../lib/typo";

const crumbs = [
  { name: "Úvod", path: "/" },
  { name: "Služby", path: "/sluzby" },
];
---

<Base
  title="Služby: elektroinstalace, rozvaděče, kamery a alarmy | Hey! Elektro Zábřeh"
  description="Elektroinstalace, rozvaděče, revize a hromosvody, wallboxy, kamerové systémy Dahua a Hikvision, alarmy Jablotron, videotelefony a datové sítě. Zábřeh, Olomoucký kraj a východní Čechy."
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    crumbs={crumbs}
    title="Služby"
    lead="Silnoproud i slaboproud od jednoho týmu. Od elektroinstalace a rozvaděče přes revize až po kamery, alarmy a datové sítě."
    photo={photos.rozvadecKabely}
  />

  {serviceGroups.map((g, gi) => (
    <section class:list={["sgroup", { "sgroup--alt": gi % 2 === 1 }]} aria-labelledby={`sg-${g.id}`}>
      <div class="wrap">
        <div class="sgroup__head">
          <h2 id={`sg-${g.id}`} class="t-h2 rv">{g.name}</h2>
          <p class="sgroup__text rv" style="--i:1">{cz(g.text)}</p>
        </div>
        <div class="sgroup__cards">
          <ServiceCards items={servicesIn(g.id).map((s) => ({ slug: s.slug }))} cols={4} />
        </div>
      </div>
    </section>
  ))}

  <section class="scta" aria-labelledby="scta-title">
    <div class="wrap scta__inner">
      <h2 id="scta-title" class="t-h2 rv">{cz("Nevíte, co přesně potřebujete?")}</h2>
      <p class="rv" style="--i:1">{cz("Popište, co řešíte, a my navrhneme řešení. Obhlídka i nabídka jsou nezávazné.")}</p>
      <div class="scta__actions rv" style="--i:2">
        <a href={link("/kontakt#poptavka")} class="btn btn-hey" data-track="cta" data-cta="sluzby-cta">Nezávazná poptávka</a>
        <a href={link("/caste-dotazy")} class="btn btn-ghost">Časté dotazy <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>

  <FormSection />
  <PhoneCta />
</Base>

<style>
  .sgroup { padding-block: var(--section); }
  .sgroup--alt { background: var(--color-night-2); }
  .sgroup--alt :global(.scards__a) { background: var(--color-night-3); }
  .sgroup__head { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 16px clamp(24px, 4vw, 72px); align-items: end; margin-bottom: clamp(28px, 3.5vw, 48px); }
  .sgroup__text { color: var(--color-muted); max-width: 52ch; }
  .scta { padding-block: var(--section); }
  .scta__inner { display: grid; justify-items: center; text-align: center; gap: 16px; }
  .scta__inner p { color: var(--color-muted); max-width: 52ch; }
  .scta__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 12px; }
  @media (max-width: 1023px) {
    .sgroup__head { grid-template-columns: 1fr; }
  }
</style>
