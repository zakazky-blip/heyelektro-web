---
import { link } from "../../lib/url";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import Faq from "../../components/Faq.astro";
import FormSection from "../../components/FormSection.astro";
import PhoneCta from "../../components/PhoneCta.astro";
import { services, serviceBySlug, type Service } from "../../data/services";
import { cities, regions } from "../../data/locations";
import { Image } from "astro:assets";
import ServiceCards from "../../components/ServiceCards.astro";
import { photos, serviceImage, serviceImage2 } from "../../data/images";
import { breadcrumbSchema, faqSchema, serviceSchema } from "../../lib/schema";
import { cz } from "../../lib/typo";

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}

const { service: s } = Astro.props as { service: Service };
const photo = photos[serviceImage[s.image]];
const photo2 = photos[serviceImage2[s.image]];
const crumbs = [
  { name: "Úvod", path: "/" },
  { name: "Služby", path: "/sluzby" },
  { name: s.name, path: `/sluzby/${s.slug}` },
];
const related = s.related.map((r) => serviceBySlug(r)!).filter(Boolean);
// Krátké názvy pro odkazy „služba + město“ (interní prolinkování na lokality)
const shortName: Record<string, string> = {
  "kamerove-systemy": "Kamery",
  "zabezpeceni-jablotron": "Alarmy Jablotron",
  rozvadece: "Rozvaděče",
  elektroinstalace: "Elektrikář",
  "revize-a-hromosvody": "Revize",
  wallboxy: "Wallboxy",
  "datove-site-a-wifi": "Sítě a Wi-Fi",
  "videotelefony-a-pristupove-systemy": "Videotelefony",
};
---

<Base
  title={s.seoTitle}
  description={s.description}
  schema={[serviceSchema(s), breadcrumbSchema(crumbs), faqSchema(s.faq)]}
>
  <PageHero crumbs={crumbs} title={s.h1} lead={s.lead} photo={photo} />

  <section class="inc" aria-labelledby="inc-title">
    <div class="wrap inc__grid">
      <h2 id="inc-title" class="t-h2 inc__h rv">Co pro vás uděláme</h2>
      <div class="inc__list">
        {s.includes.map((it, i) => (
          <div class="inc__item rv" style={`--i:${i % 2}`}>
            <h3>{cz(it.title)}</h3>
            <p>{cz(it.text)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="det" aria-labelledby="det-title">
    <div class="wrap det__grid">
      <div class="det__side">
        <h2 id="det-title" class="t-h2 det__h rv">{cz(s.detail.heading)}</h2>
        <div class="det__img rv" style="--i:1"><Image src={photo2.src} alt={photo2.alt} widths={[480, 800, 1100]} sizes="(max-width: 1023px) 100vw, 40vw" loading="lazy" /></div>
      </div>
      <div class="det__body prose rv" style="--i:1">
        {s.detail.paragraphs.map((p) => <p>{cz(p)}</p>)}
      </div>
      <div class="det__clean rv" style="--i:2">
        <h3>Bez zbytečného sekání</h3>
        <p>{cz(s.cleanWork)}</p>
      </div>
    </div>
  </section>

  <section class="who" aria-labelledby="who-title">
    <div class="wrap">
      <h2 id="who-title" class="t-h2 rv">Pro koho</h2>
      <div class="who__row">
        {s.forWhom.map((w, i) => (
          <div class="who__item rv" style={`--i:${i}`}>
            <h3>{cz(w.title)}</h3>
            <p>{cz(w.text)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Faq faq={s.faq} title="Časté dotazy" id="faq-sluzba" />

  <section class="where" aria-labelledby="where-title">
    <div class="wrap where__grid">
      <div>
        <h2 id="where-title" class="t-h2 rv">{cz(`${s.name} v regionu`)}</h2>
        <p class="where__p rv" style="--i:1">{cz("Sídlíme v Zábřehu a pravidelně jezdíme po Olomouckém kraji, východních Čechách, do Opavy a Ostravy.")}</p>
        <ul class="where__regions rv" style="--i:2">
          {regions.map((r) => <li><a href={link(`/lokality/${r.slug}`)} class="link-u">{r.name}</a></li>)}
        </ul>
      </div>
      <ul class="where__cities">
        {cities.map((c, i) => (
          <li class="rv" style={`--i:${i % 4}`}>
            <a href={link(`/lokality/${c.slug}`)}>
              <span>{shortName[s.slug] ?? s.name} {c.name}</span>
              <span class="where__km">{c.km === 0 ? "sídlo" : `${c.km} km`}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="rel" aria-labelledby="rel-title">
    <div class="wrap">
      <h2 id="rel-title" class="t-h2 rv">Souvisí s tím</h2>
      <div class="rel__row">
        <ServiceCards items={related.map((r) => ({ slug: r.slug }))} />
      </div>
    </div>
  </section>

  <FormSection service={s.slug} text={`Napište, co potřebujete. Službu „${s.name}“ máte ve formuláři už vybranou. Ozveme se vám a domluvíme obhlídku.`} />
  <PhoneCta />
</Base>

<style>
  .inc { padding-block: var(--section); }
  .inc__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(16px, 2vw, 32px); align-items: start; }
  .inc__h { grid-column: 1 / span 4; position: sticky; top: 110px; }
  .inc__list { grid-column: 5 / span 8; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(36px, 4vw, 56px) clamp(24px, 3vw, 48px); }
  .inc__item h3 { font-size: var(--fs-lead); letter-spacing: -0.02em; line-height: 1.2; }
  .inc__item h3::before { content: ""; display: block; width: 22px; height: 6px; background: var(--color-hey); margin-bottom: 16px; transform: skewX(-20deg); }
  .inc__item p { margin-top: 10px; max-width: 42ch; }

  .det { background: var(--color-night-2); padding-block: var(--section); }
  .det__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(16px, 2vw, 32px); row-gap: 40px; align-items: start; }
  .det__side { grid-column: 1 / span 5; grid-row: 1 / span 2; display: grid; gap: 32px; align-content: start; }
  .det__img { aspect-ratio: 4 / 3; overflow: hidden; background: var(--color-night-3); }
  .det__img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .det__body { grid-column: 6 / span 7; }
  .det__clean { grid-column: 6 / span 7; background: var(--color-night-3); padding: clamp(24px, 3vw, 36px); }
  .det__clean h3 { font-size: var(--fs-body); color: var(--color-hey); letter-spacing: 0; }
  .det__clean p { margin-top: 10px; font-size: var(--fs-lead); line-height: 1.4; max-width: 48ch; }

  .who { padding-block: var(--section); }
  .who__row { margin-top: clamp(40px, 5vw, 64px); display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(20px, 3vw, 40px); }
  .who__item h3 { font-size: var(--fs-h3); letter-spacing: -0.03em; line-height: 1.1; }
  .who__item p { margin-top: 12px; color: var(--color-muted); }

  .where { padding-block: var(--section); background: var(--color-night-2); }
  .where__grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(32px, 5vw, 80px); align-items: start; }
  .where__p { margin-top: 20px; max-width: 40ch; }
  .where__regions { list-style: none; padding: 0; margin: 24px 0 0; display: grid; gap: 8px; font-weight: 500; }
  .where__cities { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px; }
  .where__cities a { display: flex; justify-content: space-between; gap: 12px; align-items: center; min-height: 52px; padding: 0 16px; background: var(--color-night-3); text-decoration: none; font-weight: 500; transition: background-color 160ms var(--ease-out); }
  .where__km { color: var(--color-muted); font-variant-numeric: tabular-nums; font-weight: 400; white-space: nowrap; }

  .rel { padding-block: var(--section); }
  .rel__row { margin-top: clamp(32px, 4vw, 48px); }
  .rel__item { display: grid; align-content: start; gap: 10px; padding: clamp(22px, 2.5vw, 32px); background: var(--color-night-2); text-decoration: none; min-height: 180px; transition: background-color 160ms var(--ease-out), transform 160ms var(--ease-out); }
  .rel__item:active { transform: scale(0.99); }
  .rel__name { font-size: var(--fs-lead); font-weight: 700; letter-spacing: -0.02em; }
  .rel__text { color: var(--color-muted); }

  @media (hover: hover) and (pointer: fine) {
    .where__cities a:hover, .rel__item:hover { background: #2c3846; }
  }
  @media (max-width: 1023px) {
    .inc__h, .det__side, .det__body, .det__clean { grid-column: 1 / -1; }
    .det__side { grid-row: auto; }
    .inc__h { position: static; margin-bottom: 36px; }
    .inc__list { grid-column: 1 / -1; }
    .who__row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .where__grid { grid-template-columns: 1fr; }
    .rel__item { min-height: 0; }
  }
  @media (max-width: 600px) {
    .inc__list, .who__row, .where__cities { grid-template-columns: 1fr; }
  }
</style>
