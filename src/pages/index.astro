---
import Base from "../layouts/Base.astro";
import Hero from "../components/home/Hero.astro";
import Ticker from "../components/home/Ticker.astro";
import Services from "../components/home/Services.astro";
import WhyUs from "../components/home/WhyUs.astro";
import Process from "../components/home/Process.astro";
import Dojezd from "../components/Dojezd.astro";
import Faq from "../components/Faq.astro";
import FormSection from "../components/FormSection.astro";
import PhoneCta from "../components/PhoneCta.astro";
import { websiteSchema, faqSchema } from "../lib/schema";
import { generalFaq as faq } from "../data/faq";
---

<Base
  title="Elektrikář, kamery a alarmy Zábřeh a Olomouc | Hey! Elektro"
  description="Elektroinstalace, rozvaděče a revize, kamery Dahua a Hikvision a alarmy Jablotron. Certifikovaní technici ze Zábřehu pro Olomoucký kraj, východní Čechy, Opavu a Ostravu."
  schema={[websiteSchema(), faqSchema(faq)]}
  home
>
  <Hero />
  <Ticker />
  <Services />
  <WhyUs />
  <Process />
  <Dojezd />
  <Faq faq={faq} />
  <FormSection />
  <PhoneCta />
</Base>
