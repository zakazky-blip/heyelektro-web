---
import { link } from "../lib/url";
import { site } from "../data/site";
---

<div class="mbar" data-mobile-bar>
  <a href={site.phone.href} class="mbar__call" data-track="phone" data-cta="mobile-bar">
    <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z"/></svg>
    Zavolat
  </a>
  <a href={link("/kontakt#poptavka")} class="mbar__form" data-track="cta" data-cta="mobile-bar">Poptávka</a>
</div>

<style>
  .mbar { display: none; }
  @media (max-width: 767px) {
    .mbar {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 45;
      display: grid; grid-template-columns: 1.4fr 1fr; gap: 8px;
      padding: 8px max(8px, env(safe-area-inset-right, 0px)) calc(8px + env(safe-area-inset-bottom, 0px)) max(8px, env(safe-area-inset-left, 0px));
      background: var(--color-night-2);
      transition: transform 260ms var(--ease-out);
    }
    .mbar.is-hidden, .mbar.is-away { transform: translateY(110%); }
    .mbar a {
      display: flex; align-items: center; justify-content: center; gap: 10px;
      min-height: 54px; font-weight: 700; font-size: 1.05rem; text-decoration: none;
      transition: transform 120ms var(--ease-out), background-color 120ms;
      user-select: none; -webkit-user-select: none; -webkit-touch-callout: none;
    }
    .mbar a:active { transform: scale(0.97); }
    .mbar__call { background: var(--color-hey); color: var(--color-night); }
    .mbar__call:active { background: var(--color-hey-press); }
    .mbar__form { background: var(--color-night-3); color: var(--color-ink); }
  }
</style>
