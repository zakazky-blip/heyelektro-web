---
// Postup: tři fotky různých formátů po klesající diagonále, text v mezerách.
import { Image } from "astro:assets";
import { photos } from "../../data/images";
import { cz } from "../../lib/typo";

const stages = [
  {
    runin: "Nejdřív obhlídka a návrh.",
    text: "Přijedeme, projdeme objekt a zeptáme se, co chcete hlídat nebo zapojit. Navrhneme řešení a pošleme nabídku s rozpisem materiálu, práce i dopravy.",
    photo: photos.mereni,
  },
  {
    runin: "Potom montáž.",
    text: "V domluvený termín natáhneme kabely, zapojíme a nastavíme. Kde to jde, pracujeme bez sekání, a po sobě uklidíme.",
    photo: photos.elektrikarHelma,
  },
  {
    runin: "Nakonec předání.",
    text: "Nastavíme vám aplikaci, ukážeme ovládání a předáme dokumentaci i revizní zprávu. Když budete chtít systém rozšířit nebo poradit, zavoláte nám.",
    photo: photos.dumNoc,
  },
];
---

<section class="proc" aria-labelledby="proc-title">
  <div class="wrap proc__grid">
    <h2 id="proc-title" class="proc__title rv">Jak to probíhá</h2>
    {stages.map((s, i) => (
      <Fragment>
        <div class={`proc__photo proc__photo--${i + 1} rv`}>
          <Image src={s.photo.src} alt={s.photo.alt} widths={[420, 720, 1100]} sizes={i === 2 ? "(max-width: 1023px) 80vw, 40vw" : "(max-width: 1023px) 100vw, 30vw"} loading="lazy" />
        </div>
        <p class={`proc__text proc__text--${i + 1} rv`} style="--i:1"><strong>{cz(s.runin)}</strong> {cz(s.text)}</p>
      </Fragment>
    ))}
  </div>
</section>

<style>
  .proc { padding-block: var(--section); }
  .proc__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(16px, 2vw, 32px); align-items: start; }
  .proc__title { grid-column: 7 / span 6; grid-row: 1; font-weight: 400; font-size: var(--fs-display); letter-spacing: -0.04em; line-height: 1; }

  .proc__photo { overflow: hidden; background: var(--color-night-2); }
  .proc__photo :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1200ms var(--ease-out); }
  .proc__text { max-width: 36ch; }
  .proc__text strong { font-weight: 700; color: var(--color-hey); }

  .proc__photo--1 { grid-column: 1 / span 4; grid-row: 1 / span 2; aspect-ratio: 3 / 4; }
  .proc__text--1 { grid-column: 5 / span 3; grid-row: 2; padding-top: 24px; }
  .proc__photo--2 { grid-column: 6 / span 3; grid-row: 3; aspect-ratio: 1; margin-top: -80px; }
  .proc__text--2 { grid-column: 9 / span 4; grid-row: 3; margin-top: -80px; }
  .proc__photo--3 { grid-column: 8 / span 5; grid-row: 4; aspect-ratio: 16 / 10; margin-top: 64px; }
  .proc__text--3 { grid-column: 3 / span 4; grid-row: 4; margin-top: 64px; justify-self: end; }

  @media (hover: hover) and (pointer: fine) {
    .proc__photo:hover :global(img) { transform: scale(1.03); }
  }

  @media (max-width: 1023px) {
    .proc__grid { display: flex; flex-direction: column; }
    .proc__title { margin-bottom: 36px; }
    .proc__photo, .proc__text { margin: 0 !important; padding: 0 !important; }
    .proc__text { margin-top: 18px !important; margin-bottom: 52px !important; }
    .proc__photo--1 { width: 100%; aspect-ratio: 4 / 3; }
    .proc__photo--2, .proc__text--2 { width: 62%; align-self: flex-end; }
    .proc__photo--3, .proc__text--3 { width: 78%; align-self: flex-start; }
    .proc__text--3 { margin-bottom: 0 !important; }
  }
  @media (max-width: 560px) {
    .proc__text--2, .proc__text--3 { width: 100%; }
  }
</style>
