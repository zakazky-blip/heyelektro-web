---
// Proč Hey! Elektro: velká fotka se štítkem certifikací vlevo, důvody s ikonami vpravo.
import { Image } from "astro:assets";
import { photos } from "../../data/images";
import { cz } from "../../lib/typo";
import type { IconName } from "../../lib/icons";
import Icon from "../Icon.astro";

const reasons: { icon: IconName; title: string; text: string }[] = [
  { icon: "bolt", title: "Silnoproud i slaboproud v jednom", text: "Rozvaděč, elektroinstalaci, kamery, alarm i datovou síť navrhneme a zapojíme jako jeden celek. Nemusíte koordinovat tři firmy." },
  { icon: "broom", title: "Čistá práce", text: "Kde to jde, montujeme bez sekání: bezdrátové prvky, kabely v podhledu nebo liště. Po sobě uklidíme." },
  { icon: "shield", title: "Certifikovaní technici", text: "Partner Jablotron, certifikace na kamery Dahua a Hikvision. Revize s revizní zprávou zajistíme." },
  { icon: "doc", title: "Nabídka s rozpisem předem", text: "Materiál, práce i doprava zvlášť. Cenu znáte dřív, než začneme." },
  { icon: "check", title: "Předání s dokumentací", text: "Schéma zapojení, popis obvodů, nastavená aplikace v telefonu a zaškolení na místě." },
];
const p = photos.rozvadecKabely;
---

<section class="why" aria-labelledby="why-title">
  <div class="wrap why__grid">
    <div class="why__media rv">
      <Image src={p.src} alt={p.alt} widths={[480, 760, 1100]} sizes="(max-width: 1023px) 100vw, 45vw" loading="lazy" class="why__img" />
      <div class="why__stamp">
        <Icon name="shield" size={28} />
        <p>{cz("Certifikovaný partner Jablotron, Dahua a Hikvision")}</p>
      </div>
    </div>
    <div class="why__body">
      <h2 id="why-title" class="t-h2 rv">Proč Hey! Elektro</h2>
      <ul class="why__list">
        {reasons.map((r, i) => (
          <li class="rv" style={`--i:${i % 3}`}>
            <span class="why__icon"><Icon name={r.icon} size={24} /></span>
            <div>
              <h3>{cz(r.title)}</h3>
              <p>{cz(r.text)}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .why { padding-block: var(--section); background: var(--color-night-2); }
  .why__grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(32px, 6vw, 112px); align-items: center; }
  .why__media { position: relative; aspect-ratio: 4 / 5; overflow: hidden; background: var(--color-night-3); }
  .why__media :global(.why__img) { width: 100%; height: 100%; object-fit: cover; }
  .why__stamp {
    position: absolute; left: 0; bottom: 0; display: flex; align-items: center; gap: 14px;
    max-width: 82%; padding: 18px 22px; background: var(--color-hey); color: var(--color-night);
  }
  .why__stamp p { font-weight: 700; line-height: 1.3; }
  .why__list { list-style: none; margin: clamp(28px, 3vw, 44px) 0 0; padding: 0; display: grid; gap: clamp(22px, 2.4vw, 32px); }
  .why__list li { display: grid; grid-template-columns: 52px 1fr; gap: 18px; align-items: start; }
  .why__icon { display: grid; place-items: center; width: 52px; height: 52px; color: var(--color-hey); background: rgb(254 202 20 / 0.1); }
  .why__list h3 { font-size: var(--fs-lead); letter-spacing: -0.02em; line-height: 1.2; }
  .why__list p { margin-top: 6px; color: var(--color-muted); max-width: 52ch; }
  @media (max-width: 1023px) {
    .why__grid { grid-template-columns: 1fr; }
    .why__media { aspect-ratio: 4 / 3; }
    .why__body { order: -1; }
  }
  @media (max-width: 560px) {
    .why__list li { grid-template-columns: 44px 1fr; gap: 14px; }
    .why__icon { width: 44px; height: 44px; }
  }
</style>
