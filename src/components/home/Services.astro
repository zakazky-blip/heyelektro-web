---
// Služby jako fotogalerie (bento). Elektro a zabezpečení mají stejnou váhu:
// dvě velké dlaždice (elektroinstalace, kamery), pod nimi šest menších.
import { Image } from "astro:assets";
import { link } from "../../lib/url";
import { serviceBySlug } from "../../data/services";
import { photos, type PhotoKey } from "../../data/images";
import { serviceIcon } from "../../lib/icons";
import { cz } from "../../lib/typo";
import Icon from "../Icon.astro";

const tiles: { slug: string; photo: PhotoKey; size: "xl" | "s"; text?: string }[] = [
  { slug: "elektroinstalace", photo: "elektrikar", size: "xl", text: "Novostavby, rekonstrukce bytů a domů, firmy a provozovny. Od hrubé instalace po revizi." },
  { slug: "kamerove-systemy", photo: "kamera", size: "xl", text: "Dahua a Hikvision, noční vidění, záznam u vás doma a obraz v mobilu." },
  { slug: "rozvadece", photo: "rozvadec", size: "s" },
  { slug: "zabezpeceni-jablotron", photo: "dumNoc", size: "s" },
  { slug: "revize-a-hromosvody", photo: "kleste", size: "s" },
  { slug: "wallboxy", photo: "wallbox", size: "s" },
  { slug: "videotelefony-a-pristupove-systemy", photo: "videotelefon", size: "s" },
  { slug: "datove-site-a-wifi", photo: "sit", size: "s" },
];
const items = tiles.map((t) => ({ ...t, s: serviceBySlug(t.slug)!, p: photos[t.photo] }));
---

<section class="svc" aria-labelledby="svc-title">
  <div class="wrap">
    <div class="svc__head">
      <h2 id="svc-title" class="t-h2 rv">Co pro vás uděláme</h2>
      <p class="svc__lead rv" style="--i:1">{cz("Silnoproud i slaboproud od jednoho týmu. Elektroinstalaci, rozvaděč, kamery i alarm navrhneme tak, aby do sebe zapadly.")}</p>
    </div>

    <ul class="svc__grid">
      {items.map((it, i) => (
        <li class={`svc__tile svc__tile--${it.size} rv`} style={`--i:${i % 3}`}>
          <a href={link(`/sluzby/${it.s.slug}`)} class="svc__a">
            <Image
              src={it.p.src}
              alt=""
              widths={it.size === "xl" ? [480, 760, 1100] : [360, 560, 760]}
              sizes={it.size === "xl" ? "(max-width: 767px) 100vw, 50vw" : "(max-width: 767px) 100vw, 33vw"}
              loading="lazy"
              class="svc__img"
            />
            <span class="svc__scrim" aria-hidden="true"></span>
            <span class="svc__icon"><Icon name={serviceIcon[it.s.slug]} size={it.size === "xl" ? 26 : 22} /></span>
            <span class="svc__body">
              <h3 class="svc__title">{it.s.name}</h3>
              <span class="svc__text">{cz(it.text ?? it.s.short)}</span>
            </span>
            <span class="svc__go" aria-hidden="true"><Icon name="arrow" size={20} /></span>
          </a>
        </li>
      ))}
    </ul>

    <p class="svc__all rv"><a href={link("/sluzby")} class="btn btn-ghost">Přehled všech služeb <Icon name="arrow" size={18} /></a></p>
  </div>
</section>

<style>
  .svc { padding-block: var(--section); }
  .svc__head { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: 24px clamp(24px, 4vw, 72px); align-items: end; margin-bottom: clamp(32px, 4vw, 56px); }
  .svc__lead { color: var(--color-muted); max-width: 46ch; }

  .svc__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); grid-auto-rows: clamp(220px, 21vw, 300px); gap: 8px; }
  .svc__tile--xl { grid-column: span 6; grid-row: span 2; }
  .svc__tile--s { grid-column: span 4; }

  .svc__a {
    position: relative; display: flex; flex-direction: column; justify-content: flex-end; height: 100%;
    padding: clamp(18px, 2vw, 28px); overflow: hidden; text-decoration: none; isolation: isolate;
    background: var(--color-night-2);
    transition: transform 180ms var(--ease-out);
  }
  .svc__a:active { transform: scale(0.985); }
  .svc__a :global(.svc__img) { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; transition: transform 1200ms var(--ease-out), filter 600ms var(--ease-out); filter: saturate(0.9); }
  .svc__scrim { position: absolute; inset: 0; z-index: -1; /* taste-skill-ignore: neutrální scrim přes fotku kvůli čitelnosti textu */ background: linear-gradient(180deg, rgb(10 14 19 / 0.1) 0%, rgb(10 14 19 / 0.45) 45%, rgb(10 14 19 / 0.92) 100%); transition: opacity 400ms var(--ease-out); }
  .svc__a::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 4px; background: var(--color-hey);
    transform: scaleX(0); transform-origin: left; transition: transform 420ms var(--ease-out);
  }

  .svc__icon { position: absolute; top: clamp(16px, 1.8vw, 24px); left: clamp(16px, 1.8vw, 24px); display: grid; place-items: center; width: 48px; height: 48px; background: var(--color-hey); color: var(--color-night); }
  .svc__tile--s .svc__icon { width: 42px; height: 42px; }
  .svc__body { display: grid; gap: 8px; padding-right: 48px; }
  .svc__title { font-size: var(--fs-lead); letter-spacing: -0.02em; line-height: 1.15; }
  .svc__tile--xl .svc__title { font-size: var(--fs-h2); letter-spacing: -0.035em; }
  .svc__text { color: rgb(255 255 255 / 0.82); font-size: var(--fs-small); line-height: 1.5; max-width: 40ch; }
  .svc__tile--xl .svc__text { font-size: var(--fs-body); }
  .svc__go {
    position: absolute; right: clamp(16px, 1.8vw, 24px); bottom: clamp(18px, 2vw, 28px);
    display: grid; place-items: center; width: 40px; height: 40px; color: var(--color-night); background: #fff;
    transition: transform 260ms var(--ease-out), background-color 200ms;
  }
  .svc__all { margin-top: clamp(28px, 3vw, 40px); display: flex; justify-content: center; }

  @media (hover: hover) and (pointer: fine) {
    .svc__a:hover :global(.svc__img) { transform: scale(1.06); filter: saturate(1.05); }
    .svc__a:hover::after { transform: scaleX(1); }
    .svc__a:hover .svc__go { background: var(--color-hey); transform: translateX(4px); }
  }
  .svc__a:focus-visible { outline-offset: -3px; }

  @media (max-width: 1023px) {
    .svc__head { grid-template-columns: 1fr; }
    .svc__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: 240px; }
    .svc__tile--xl { grid-column: span 2; grid-row: span 1; }
    .svc__tile--xl .svc__a { min-height: 300px; }
    .svc__tile--s { grid-column: span 1; }
  }
  @media (max-width: 560px) {
    .svc__grid { grid-template-columns: 1fr; grid-auto-rows: auto; }
    .svc__tile--xl, .svc__tile--s { grid-column: auto; }
    .svc__tile--xl .svc__a { min-height: 320px; }
    .svc__tile--s .svc__a { min-height: 210px; }
  }
</style>
