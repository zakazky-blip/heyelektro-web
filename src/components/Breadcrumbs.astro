---
import { link } from "../lib/url";
interface Props { items: { name: string; path: string }[] }
const { items } = Astro.props;
---

<nav class="crumbs" aria-label="Drobečková navigace">
  <ol>
    {items.map((it, i) => (
      <li>
        {i < items.length - 1 ? <a href={link(it.path)}>{it.name}</a> : <span aria-current="page">{it.name}</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .crumbs ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 0; font-size: var(--fs-small); color: var(--color-muted); }
  .crumbs li:not(:last-child)::after { content: "/"; margin: 0 10px; opacity: 0.6; }
  .crumbs a { color: var(--color-muted); text-decoration: none; }
  .crumbs [aria-current] { color: var(--color-ink); }
  @media (hover: hover) and (pointer: fine) { .crumbs a:hover { color: var(--color-ink); text-decoration: underline; } }
</style>
