  phone: '<path d="M6.7 3.5h2.8l1.4 4-2 1.4a12 12 0 0 0 6.2 6.2l1.4-2 4 1.4v2.8a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.7 5.7a2 2 0 0 1 2-2.2z"/>',
