  charger: '<rect x="5" y="3" width="10" height="18" rx="2"/><path d="M15 9h2.5a1.5 1.5 0 0 1 1.5 1.5V17a2 2 0 0 0 2 2"/><path d="m10.8 7-2.3 3.6h2.2l-.8 3.4 2.6-4h-2.1z"/>',
  wifi: '<path d="M2.5 9a14 14 0 0 1 19 0"/><path d="M5.8 12.5a9 9 0 0 1 12.4 0"/><path d="M9.2 16a4 4 0 0 1 5.6 0"/><circle cx="12" cy="19.2" r="1" fill="currentColor"/>',
  intercom: '<rect x="6" y="2.5" width="12" height="19" rx="2"/><circle cx="12" cy="7.5" r="2.2"/><path d="M9 13.5h6M9 16.5h6"/>',
  check: '<path d="m4.5 12.5 4.5 4.5 10.5-11"/>',
  pin: '<path d="M12 21s-6.5-6.2-6.5-11.2a6.5 6.5 0 0 1 13 0C18.5 14.8 12 21 12 21z"/><circle cx="12" cy="9.8" r="2.4"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/>',
