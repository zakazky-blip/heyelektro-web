# Zkopírujte do .env (lokálně) nebo nastavte v Vercel → Project → Settings → Environment Variables.

# Google Tag Manager (GTM-XXXXXXX). Bez něj se žádné měření nenačte.
PUBLIC_GTM_ID=

# Odesílání poptávek e-mailem přes Resend (resend.com). Doména heyelektro.cz musí být v Resend ověřená.
RESEND_API_KEY=
FORM_TO=info@heyelektro.cz
FORM_FROM="Web Hey! Elektro <web@heyelektro.cz>"

# Jen pro automatické audity layoutu: vynechá cookie lištu. V produkci NIKDY nenastavovat.
# PUBLIC_AUDIT_NO_BANNER=1
